# Copie para .env (que já está no .gitignore) e preencha. NUNCA suba o .env real.
# No Render, cadastre estas variáveis em Environment.

# Senha do painel admin (mínimo 12 caracteres). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=troque-por-um-valor-longo-e-aleatorio

# Sites autorizados a chamar a API, separados por vírgula (sem barra no final)
CORS_ORIGINS=https://seu-site.vercel.app,http://localhost:5173

# Banco de produção (Postgres). Sem isso, usa SQLite local.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Em produção, desliga a documentação /docs
# ENV=production
